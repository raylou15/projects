rays-games.loseyourip.com {
	route {
		# API -> Node (strip /api)
		handle_path /api/* {
			reverse_proxy 127.0.0.1:3000
		}

		# WebSocket endpoint -> Node
		handle /ws* {
			reverse_proxy 127.0.0.1:3000
		}

		# Canonical legal URLs (avoid SPA fallback swallowing non-slash paths)
		redir /terms /terms/ 308
		redir /privacy /privacy/ 308

		# Multi-game frontends under /g/<slug>/ with per-game SPA fallback
		@game path_regexp game ^/g/([^/]+)(?:/.*)?$
		handle @game {
			root * /var/www/rays-games
			try_files {path} {path}/index.html /g/{re.game.1}/index.html
			file_server
		}

		# Existing root behavior remains unchanged
		handle {
			root * /var/www/rays-games
			try_files {path} {path}/index.html /index.html
			file_server
		}
	}
}
