rays-games.loseyourip.com {

  log {
    output file /var/log/caddy/rays-games-access.log
    format console
  }

  # =========================
  # BACKEND (Express) - root paths
  # =========================
  handle /api/* {
    reverse_proxy 127.0.0.1:3000
  }
  handle /token {
    reverse_proxy 127.0.0.1:3000
  }
  handle /health {
    reverse_proxy 127.0.0.1:3000
  }

  # WebSocket (root)
  handle /ws* {
    reverse_proxy 127.0.0.1:3000
  }

  # =========================
  # BACKEND (Express) - scoped under /context-clues/*
  # (If Discord proxy/root mapping causes requests to land here)
  # =========================
  handle /context-clues/api/* {
    uri strip_prefix /context-clues
    reverse_proxy 127.0.0.1:3000
  }
  handle /context-clues/token {
    uri strip_prefix /context-clues
    reverse_proxy 127.0.0.1:3000
  }
  handle /context-clues/health {
    uri strip_prefix /context-clues
    reverse_proxy 127.0.0.1:3000
  }
  handle /context-clues/ws* {
    uri strip_prefix /context-clues
    reverse_proxy 127.0.0.1:3000
  }

  # =========================
  # BACKEND (Express) - scoped under /trivia/*
  # =========================
  handle /trivia/api/* {
    uri strip_prefix /trivia
    reverse_proxy 127.0.0.1:3000
  }
  handle /trivia/token {
    uri strip_prefix /trivia
    reverse_proxy 127.0.0.1:3000
  }
  handle /trivia/health {
    uri strip_prefix /trivia
    reverse_proxy 127.0.0.1:3000
  }
  handle /trivia/ws* {
    uri strip_prefix /trivia
    reverse_proxy 127.0.0.1:3000
  }

  # =========================
  # FRONTENDS (Vite dist) - single block per app
  # (IMPORTANT: don't use a separate /assets handle_path; it causes 404s)
  # =========================
  handle_path /context-clues/* {
    root * /var/www/rays-games/context-clues
    try_files {path} /index.html
    file_server
  }

  handle_path /trivia/* {
    root * /var/www/rays-games/trivia
    try_files {path} /index.html
    file_server
  }
}
