rays-games.loseyourip.com {

  log {
    output file /var/log/caddy/rays-games-access.log
    format console
  }

  # -------------------------
  # Backend (must be first)
  # -------------------------

  # Discord token exchange endpoints (your client is calling /token)
  handle /token {
    reverse_proxy 127.0.0.1:3000
  }
  handle /api/token {
    reverse_proxy 127.0.0.1:3000
  }

  # Discord-style proxy prefix (some SDK examples use /.proxy/api/...)
  handle_path /.proxy/* {
    reverse_proxy 127.0.0.1:3000
  }

  # API + WS (root)
  handle /api/* {
    reverse_proxy 127.0.0.1:3000
  }
  handle /ws* {
    reverse_proxy 127.0.0.1:3000
  }

  # -------------------------
  # Static apps
  # -------------------------

  redir /context-clues /context-clues/ 308
  redir /trivia /trivia/ 308

  # Context Clues
  handle_path /context-clues/* {
    root * /var/www/rays-games/context-clues
    try_files {path} {path}/ /index.html
    file_server
  }
  # Compat (double-prefix)
  handle_path /context-clues/context-clues/* {
    root * /var/www/rays-games/context-clues
    try_files {path} {path}/ /index.html
    file_server
  }

  # Trivia
  handle_path /trivia/* {
    root * /var/www/rays-games/trivia
    try_files {path} {path}/ /index.html
    file_server
  }
  # Compat (double-prefix)
  handle_path /trivia/trivia/* {
    root * /var/www/rays-games/trivia
    try_files {path} {path}/ /index.html
    file_server
  }

  # Optional root message (safe now; /token is already handled above)
  handle / {
    respond "Rays Games is up. Try /context-clues/ or /trivia/." 200
  }
}