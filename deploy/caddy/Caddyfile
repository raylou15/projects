rays-games.loseyourip.com {

  # ---- Backend (always proxy these) ----
  handle /api/* {
    reverse_proxy 127.0.0.1:3000
  }

  handle /token {
    reverse_proxy 127.0.0.1:3000
  }

  handle /client-log {
    reverse_proxy 127.0.0.1:3000
  }

  handle /health {
    reverse_proxy 127.0.0.1:3000
  }

  handle /ws* {
    reverse_proxy 127.0.0.1:3000
  }

  # ---- Context Clues ----
  handle_path /context-clues/assets/* {
    root * /var/www/rays-games/context-clues
    file_server
  }

  handle_path /context-clues/* {
    root * /var/www/rays-games/context-clues
    try_files {path} {path}/ /index.html
    file_server
  }

  # ---- Trivia ----
  handle_path /trivia/assets/* {
    root * /var/www/rays-games/trivia
    file_server
  }

  handle_path /trivia/* {
    root * /var/www/rays-games/trivia
    try_files {path} {path}/ /index.html
    file_server
  }

  log {
    output file /var/log/caddy/rays-games-access.log
    format console
  }
}
