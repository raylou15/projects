rays-games.loseyourip.com {

  log {
    output file /var/log/caddy/rays-games-access.log
    format console
  }

  # Backend (root)
  handle /api/* {
    reverse_proxy 127.0.0.1:3000
  }
  handle /ws* {
    reverse_proxy 127.0.0.1:3000
  }

  # Normalize slashes
  redir /context-clues /context-clues/ 308
  redir /trivia /trivia/ 308

  # -------------------------
  # Context Clues (primary)
  # -------------------------
  handle_path /context-clues/* {
    root * /var/www/rays-games/context-clues
    try_files {path} {path}/ /index.html
    file_server
  }

  # Compat: if Discord URL mapping points "/" -> ".../context-clues/"
  # then a Vite base of "/context-clues/" can cause double-prefix requests like:
  #   /context-clues/assets/...  -> forwarded to origin as /context-clues/context-clues/assets/...
  handle_path /context-clues/context-clues/* {
    root * /var/www/rays-games/context-clues
    try_files {path} {path}/ /index.html
    file_server
  }

  # -------------------------
  # Trivia (primary)
  # -------------------------
  handle_path /trivia/* {
    root * /var/www/rays-games/trivia
    try_files {path} {path}/ /index.html
    file_server
  }

  # Compat: /trivia/trivia/* (same double-prefix scenario)
  handle_path /trivia/trivia/* {
    root * /var/www/rays-games/trivia
    try_files {path} {path}/ /index.html
    file_server
  }

  # Optional: a simple root response so "/" isn't a confusing blank
  handle / {
    respond "Rays Games is up. Try /context-clues/ or /trivia/." 200
  }
}
