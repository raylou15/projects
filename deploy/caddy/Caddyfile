rays-games.loseyourip.com {
	route {
		# API -> Node (preserve /api prefix)
		handle /api/* {
			reverse_proxy 127.0.0.1:3000
		}

		# WebSocket endpoint -> Node
		handle /ws* {
			reverse_proxy 127.0.0.1:3000
		}

		# Legacy aliases -> canonical game paths
		@gcc path_regexp gcc ^/g/context-clues(?:/(.*))?$
		redir @gcc /context-clues/{re.gcc.1} 308

		@gtr path_regexp gtr ^/g/trivia(?:/(.*))?$
		redir @gtr /trivia/{re.gtr.1} 308

		# Canonical legal URLs
		redir /terms /terms/ 308
		redir /privacy /privacy/ 308

		# Context Clues SPA (strip /context-clues prefix)
		handle_path /context-clues/* {
			root * /var/www/rays-games/context-clues
			try_files {path} {path}/ /index.html
			file_server
		}

		# Trivia SPA (strip /trivia prefix)
		handle_path /trivia/* {
			root * /var/www/rays-games/trivia
			try_files {path} {path}/ /index.html
			file_server
		}

		# Terms (served from Context Clues build output)
		handle_path /terms/* {
			root * /var/www/rays-games/context-clues/terms
			try_files {path} {path}/ /index.html
			file_server
		}

		# Privacy (served from Context Clues build output)
		handle_path /privacy/* {
			root * /var/www/rays-games/context-clues/privacy
			try_files {path} {path}/ /index.html
			file_server
		}

		# Root -> primary game
		handle {
			redir / /context-clues/ 308
		}
	}
}
