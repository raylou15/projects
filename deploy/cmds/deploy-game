#!/usr/bin/env bash
set -euo pipefail

CLONE_DIR="${CLONE_DIR:-/root/github/projects}"
REPO_DIR="${REPO_DIR:-$CLONE_DIR}"

SCRIPT_PATH="$REPO_DIR/deploy/deploy-game.sh"
if [[ ! -x "$SCRIPT_PATH" ]]; then
  echo "ERROR: Missing executable: $SCRIPT_PATH" >&2
  exit 1
fi

exec env REPO_DIR="$REPO_DIR" "$SCRIPT_PATH" "$@"
