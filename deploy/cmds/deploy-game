#!/usr/bin/env bash
set -euo pipefail

CLONE_DIR="${CLONE_DIR:-/root/github/projects}"

if [ -x "$CLONE_DIR/deploy/deploy-game.sh" ]; then
  exec env REPO_DIR="$CLONE_DIR" "$CLONE_DIR/deploy/deploy-game.sh" "$@"
fi

echo "ERROR: $CLONE_DIR/deploy/deploy-game.sh not found or not executable." >&2
exit 1
