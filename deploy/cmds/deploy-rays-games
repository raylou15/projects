#!/usr/bin/env bash
set -euo pipefail

APP_NAME="${APP_NAME:-rays-games}"
GIT_URL="${GIT_URL:-https://github.com/raylou15/projects.git}"
BRANCH="${BRANCH:-main}"
CLONE_DIR="${CLONE_DIR:-/root/github/projects}"
DEST_CMDS="/usr/local/bin"

SUDO=""
if [[ "$(id -u)" -ne 0 ]]; then
  SUDO="sudo"
fi

log() {
  echo
  echo "==> $*"
}

have() {
  command -v "$1" >/dev/null 2>&1
}

log "Ensuring required packages (git, rsync, python3)"
$SUDO apt-get update -y >/dev/null
pkgs=()
have git || pkgs+=("git")
have rsync || pkgs+=("rsync")
have python3 || pkgs+=("python3")
if [[ "${#pkgs[@]}" -gt 0 ]]; then
  $SUDO apt-get install -y "${pkgs[@]}" >/dev/null
fi

log "Sync repo into $CLONE_DIR"
if [[ ! -d "$CLONE_DIR/.git" ]]; then
  $SUDO mkdir -p "$(dirname "$CLONE_DIR")"
  $SUDO git clone --branch "$BRANCH" "$GIT_URL" "$CLONE_DIR"
else
  git -C "$CLONE_DIR" fetch --all --prune
  git -C "$CLONE_DIR" checkout "$BRANCH"
  git -C "$CLONE_DIR" reset --hard "origin/$BRANCH"
fi

log "Repo HEAD"
git -C "$CLONE_DIR" --no-pager log -1 --oneline

if [[ -d "$CLONE_DIR/deploy/cmds" ]]; then
  log "Install command wrappers into $DEST_CMDS"
  $SUDO rsync -av "$CLONE_DIR/deploy/cmds/" "$DEST_CMDS/" >/dev/null
  $SUDO chmod +x "$DEST_CMDS"/deploy-* 2>/dev/null || true
fi

MASTER_SCRIPT="$CLONE_DIR/deploy/deploy-master.sh"
if [[ -x "$MASTER_SCRIPT" ]]; then
  log "Run master deploy"
  exec env REPO_DIR="$CLONE_DIR" APP_NAME="$APP_NAME" BRANCH="$BRANCH" "$MASTER_SCRIPT" "$@"
fi

echo "ERROR: Missing executable: $MASTER_SCRIPT" >&2
exit 1
