#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="${REPO_DIR:-/root/repo}"

if [[ -f "$REPO_DIR/deploy/deploy-master.sh" ]]; then
  exec "$REPO_DIR/deploy/deploy-master.sh" "$@"
fi

if [[ -f "$SCRIPT_DIR/../deploy-master.sh" ]]; then
  exec "$SCRIPT_DIR/../deploy-master.sh" "$@"
fi

echo "Unable to locate deploy/deploy-master.sh. Set REPO_DIR to your clone path." >&2
exit 1
